#!/bin/sh
. /usr/libexec/strataos/webui-cgi-common
require_auth
json_headers

escape() { printf '%s' "$1" | json_escape; }
runtime_base=$(cat /run/strataos/base.path 2>/dev/null || printf '%s' /run/strata-data/strataos)
VOLUME_CONF="$runtime_base/state/volume-overrides.conf"
SYSCTL_CONF="/etc/sysctl.d/90-strataos-tuning.conf"
SSHD_CONF="/etc/ssh/sshd_config.d/10-strataos.conf"
SWAP_FILE="/state/swap/strata.swap"

kv_get() { awk -F= -v k="$2" '$1==k{print$2;exit}' "$1" 2>/dev/null; }
kv_set() {
    conf="$1" key="$2" value="$3"
    mkdir -p "$(dirname "$conf")"
    [ -f "$conf" ] || : > "$conf"
    temporary=$conf.kv.$$
    awk -F= -v wanted="$key" -v replacement="$value" '
        BEGIN { replaced=0 }
        $1 == wanted { if (!replaced) print wanted "=" replacement; replaced=1; next }
        { print }
        END { if (!replaced) print wanted "=" replacement }
    ' "$conf" 2>/dev/null > "$temporary" || { rm -f "$temporary"; return 1; }
    mv "$temporary" "$conf"
}

# --- Component volume helpers ---
get_component_size_mib() {
    component="$1"
    data_mount=$(cat /run/strataos/data.mount 2>/dev/null || printf '%s' /run/strata-data)
    base=$(cat /run/strataos/base.path 2>/dev/null || printf '%s' "$data_mount/strataos")
    active="$base/active-slot"
    [ -s "$active" ] || { echo "0 inherit"; return; }
    slot=$(cat "$active")
    list="$base/slots/$slot/components.list"
    [ -s "$list" ] || { echo "0 inherit"; return; }
    while IFS= read -r rel; do
        case "$rel" in ''|'#'*) continue ;; esac
        file="$base/$rel"
        [ -f "$file" ] || continue
        tmpdir=$(mktemp -d /run/strata-inspect.XXXXXX) 2>/dev/null || continue
        loop=$(losetup -f --show -r "$file" 2>/dev/null) || { rmdir "$tmpdir" 2>/dev/null; continue; }
        mount -t squashfs -o ro,nosuid,nodev,noexec "$loop" "$tmpdir" 2>/dev/null || { losetup -d "$loop" 2>/dev/null; rmdir "$tmpdir"; continue; }
        meta="$tmpdir/meta/strataos/component.conf"
        if [ -s "$meta" ]; then
            name=$(kv_get "$meta" name)
            if [ "$name" = "$component" ]; then
                size=$(kv_get "$meta" storage.0.initial_size_mib)
                size=${size:-8192}
                growth=$(kv_get "$meta" storage.0.growth)
                growth=${growth:-inherit}
                mount_path=$(kv_get "$meta" storage.0.mount)
                mount_path=${mount_path:-}
                umount "$tmpdir" 2>/dev/null
                losetup -d "$loop" 2>/dev/null
                rmdir "$tmpdir" 2>/dev/null
                printf '%s %s %s\n' "$size" "$growth" "$mount_path"
                return
            fi
        fi
        umount "$tmpdir" 2>/dev/null
        losetup -d "$loop" 2>/dev/null
        rmdir "$tmpdir" 2>/dev/null
    done < "$list"
    echo "0 inherit"
}

get_volume_override() {
    component="$1" volume_id="$2" field="$3" default="$4"
    val=$(kv_get "$VOLUME_CONF" "override.${component}.${volume_id}.${field}")
    printf '%s' "${val:-$default}"
}

get_volume_usage() {
    mount_path="$1"
    if [ -n "$mount_path" ] && [ -d "$mount_path" ]; then
        df -Pk "$mount_path" 2>/dev/null | awk 'NR==2 {printf "%s %s %s", $2, $3, $4}'
    else
        echo "0 0 0"
    fi
}

volume_json() {
    component="$1" volume_id="$2" redundancy="$3" device="$4" conf_mount="$5" backing="$6"
    usage=$(get_volume_usage "$conf_mount")
    read -r total_kib used_kib avail_kib <<EOF
$usage
EOF
    total_kib=${total_kib:-0}; used_kib=${used_kib:-0}
    backing_bytes=$(stat -c %s "${backing%%,*}" 2>/dev/null || echo 0)
    current_size_mib=$((backing_bytes / 1024 / 1024)); used_mib=$((used_kib / 1024))
    [ "$current_size_mib" -gt 0 ] || current_size_mib=$((total_kib / 1024))
    current_size_mib=${current_size_mib:-0}
    override_size=$(get_volume_override "$component" "$volume_id" size_mib "$current_size_mib")
    override_growth=$(get_volume_override "$component" "$volume_id" growth boot-only)
    printf '{"id":"%s","mount":"%s","device":"%s","backing":"%s","redundancy":"%s","configured_size_mib":%s,"current_size_mib":%s,"used_mib":%s,"growth":"%s"}' \
        "$(escape "$volume_id")" "$(escape "$conf_mount")" "$(escape "$device")" "$(escape "$backing")" "$(escape "$redundancy")" \
        "$override_size" "$current_size_mib" "$used_mib" "$(escape "$override_growth")"
}

components_info() {
    printf '['; component_first=yes
    while IFS= read -r component; do
        [ -n "$component" ] || continue
        [ "$component_first" = yes ] || printf ','; component_first=no
        printf '{"name":"%s","volumes":[' "$(escape "$component")"
        volume_first=yes
        while IFS="$(printf '\t')" read -r owner volume_id redundancy device mount_path backing; do
            [ "$owner" = "$component" ] || continue
            [ "$volume_first" = yes ] || printf ','; volume_first=no
            volume_json "$owner" "$volume_id" "$redundancy" "$device" "$mount_path" "$backing"
        done < /run/strataos/volumes.tsv
        printf ']}'
    done < /run/strataos/components.seen
    printf ']'
}

# --- Docker daemon ---
docker_config_info() {
    data_root=$(sed -n 's/.*"data-root"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /etc/docker/daemon.json 2>/dev/null)
    data_root=${data_root:-/var/lib/docker}
    log_size=$(sed -n 's/.*"max-size"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /etc/docker/daemon.json 2>/dev/null)
    log_size=${log_size:-10m}
    log_file=$(sed -n 's/.*"max-file"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /etc/docker/daemon.json 2>/dev/null)
    log_file=${log_file:-3}
    log_driver=$(sed -n 's/.*"log-driver"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /etc/docker/daemon.json 2>/dev/null)
    log_driver=${log_driver:-local}
    log_level=$(sed -n 's/.*"log-level"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /etc/docker/daemon.json 2>/dev/null)
    log_level=${log_level:-info}
    live_restore=$(sed -n 's/.*"live-restore"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' /etc/docker/daemon.json 2>/dev/null)
    live_restore=${live_restore:-false}
    userland_proxy=$(sed -n 's/.*"userland-proxy"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' /etc/docker/daemon.json 2>/dev/null)
    userland_proxy=${userland_proxy:-false}
    auto_start=false
    rc-update show default 2>/dev/null | grep -q '[[:space:]]docker[[:space:]]' && auto_start=true
    printf '{"data_root":"%s","log_driver":"%s","log_max_size":"%s","log_max_file":"%s","log_level":"%s","live_restore":%s,"userland_proxy":%s,"auto_start":%s}' \
        "$(escape "$data_root")" "$(escape "$log_driver")" "$(escape "$log_size")" "$(escape "$log_file")" \
        "$(escape "$log_level")" "$live_restore" "$userland_proxy" "$auto_start"
}

# --- Kernel tuning ---
kernel_tuning_info() {
    cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "cubic")
    qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo "fq_codel")
    tfo=$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null || echo "1")
    # 0=disabled, 1=client, 2=server, 3=both
    swappiness=$(sysctl -n vm.swappiness 2>/dev/null || echo "60")
    mtu_probing=$(sysctl -n net.ipv4.tcp_mtu_probing 2>/dev/null || echo "0")
    ipv4_forward=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo "0")
    rp_filter=$(sysctl -n net.ipv4.conf.all.rp_filter 2>/dev/null || echo "0")
    printf '{"tcp_congestion":"%s","default_qdisc":"%s","tcp_fastopen":%s,"swappiness":%s,"tcp_mtu_probing":%s,"ipv4_forward":%s,"rp_filter":%s}' \
        "$(escape "$cc")" "$(escape "$qdisc")" "$tfo" "$swappiness" "$mtu_probing" "$ipv4_forward" "$rp_filter"
}

# --- SSH config ---
ssh_config_info() {
    available=false
    enabled=false
    running=false
    if [ -x /usr/sbin/sshd ] && [ -f /etc/init.d/sshd ]; then
        available=true
        rc-update show default 2>/dev/null | grep -q '[[:space:]]sshd[[:space:]]' && enabled=true
        rc-service sshd status >/dev/null 2>&1 && running=true
    fi
    port=$(awk '/^Port[[:space:]]/ {print $2; exit}' "$SSHD_CONF" 2>/dev/null || awk '/^#Port[[:space:]]/ {print $2; exit}' /etc/ssh/sshd_config 2>/dev/null || echo "22")
    permit_root=$(awk '/^PermitRootLogin[[:space:]]/ {print $2; exit}' "$SSHD_CONF" 2>/dev/null || echo "yes")
    password_auth=$(awk '/^PasswordAuthentication[[:space:]]/ {print $2; exit}' "$SSHD_CONF" 2>/dev/null || echo "yes")
    tcp_forward=$(awk '/^AllowTcpForwarding[[:space:]]/ {print $2; exit}' "$SSHD_CONF" 2>/dev/null || echo "yes")
    max_auth=$(awk '/^MaxAuthTries[[:space:]]/ {print $2; exit}' "$SSHD_CONF" 2>/dev/null || echo "6")
    idle_interval=$(awk '/^ClientAliveInterval[[:space:]]/ {print $2; exit}' "$SSHD_CONF" 2>/dev/null || echo "0")
    idle_count=$(awk '/^ClientAliveCountMax[[:space:]]/ {print $2; exit}' "$SSHD_CONF" 2>/dev/null || echo "3")
    printf '{"available":%s,"enabled":%s,"running":%s,"port":"%s","permit_root_login":"%s","password_auth":"%s","tcp_forwarding":"%s","max_auth_tries":%s,"client_alive_interval":%s,"client_alive_count_max":%s}' \
        "$available" "$enabled" "$running" "$(escape "$port")" "$(escape "$permit_root")" "$(escape "$password_auth")" "$(escape "$tcp_forward")" \
        "${max_auth:-6}" "${idle_interval:-0}" "${idle_count:-3}"
}

# --- Sensors ---
get_temps() {
    first=yes; printf '['
    for hwmon in /sys/class/hwmon/hwmon*; do
        [ -d "$hwmon" ] || continue
        name=$(cat "$hwmon/name" 2>/dev/null || echo "unknown")
        for temp in "$hwmon"/temp*_input; do
            [ -f "$temp" ] || continue
            label=$(cat "${temp%_input}_label" 2>/dev/null || echo "${temp##*/}"); label=${label%_input}
            value=$(( $(cat "$temp" 2>/dev/null || echo 0) / 1000 ))
            [ "$first" = yes ] || printf ','; first=no
            printf '{"sensor":"%s","label":"%s","value":%d,"unit":"C"}' "$(escape "$name")" "$(escape "$label")" "$value"
        done
    done
    printf ']'
}
get_gpu() {
    first=yes; printf '['
    for card in /sys/class/drm/card*; do
        [ -d "$card" ] || continue; dev=$(basename "$card")
        vendor=$(cat "/sys/class/drm/$dev/device/vendor" 2>/dev/null | sed 's/^0x//' || echo "")
        device=$(cat "/sys/class/drm/$dev/device/device" 2>/dev/null | sed 's/^0x//' || echo "")
        [ "$first" = yes ] || printf ','; first=no
        printf '{"device":"%s","vendor":"%s","device_id":"%s"}' "$(escape "$dev")" "$(escape "$vendor")" "$(escape "$device")"
    done
    printf ']'
}
get_block_devices() {
    first=yes; printf '['
    for blk in /sys/block/sd* /sys/block/nvme* /sys/block/vd* /sys/block/xvd*; do
        [ -d "$blk" ] || continue; name=$(basename "$blk")
        size_sectors=$(cat "$blk/size" 2>/dev/null || echo 0); size_kib=$((size_sectors / 2))
        ro=$(cat "$blk/ro" 2>/dev/null || echo 0)
        [ "$first" = yes ] || printf ','; first=no
        printf '{"name":"%s","size_kib":%s,"readonly":%s}' "$(escape "$name")" "$size_kib" "$ro"
    done
    printf ']'
}

# ===== GET =====
if [ "${REQUEST_METHOD:-GET}" = GET ]; then
    view=${QUERY_STRING#view=}
    case "$view" in
        settings)
            log_mode=$(kv_get /etc/conf.d/strataos-logging mode 2>/dev/null || echo "persistent")
            kernel=$(kernel_tuning_info)
            printf '{"logging_mode":"%s","kernel_tuning":%s}\n' "$log_mode" "$kernel"
            exit 0
            ;;
        storage)
            printf '{"components":%s}\n' "$(components_info)"
            exit 0
            ;;
    esac
    components=$(components_info)
    docker_cfg=null
    grep -qxF docker /run/strataos/components.seen 2>/dev/null && docker_cfg=$(docker_config_info)
    log_mode=$(kv_get /etc/conf.d/strataos-logging mode 2>/dev/null || echo "persistent")
    kernel=$(kernel_tuning_info)
    ssh=$(ssh_config_info)
    temps=$(get_temps); gpu=$(get_gpu); blk=$(get_block_devices)
    swap_total=$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    swap_free=$(awk '/^SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    swap_file_size=0
    [ -f "$SWAP_FILE" ] && swap_file_size=$(du -k "$SWAP_FILE" 2>/dev/null | awk '{print $1}')
    data_total=$(df -Pk /state 2>/dev/null | awk 'NR==2{print $2}' || df -Pk / | awk 'NR==2{print $2}')
    data_used=$(df -Pk /state 2>/dev/null | awk 'NR==2{print $3}' || df -Pk / | awk 'NR==2{print $3}')
    data_avail=$(df -Pk /state 2>/dev/null | awk 'NR==2{print $4}' || df -Pk / | awk 'NR==2{print $4}')

    printf '{"components":%s,"docker_config":%s,"logging_mode":"%s","kernel_tuning":%s,"ssh_config":%s,"temperatures":%s,"gpu":%s,"block_devices":%s,"swap_total_kib":%s,"swap_free_kib":%s,"swap_file_kib":%s,"data_total_kib":%s,"data_used_kib":%s,"data_avail_kib":%s}\n' \
        "$components" "$docker_cfg" "$log_mode" "$kernel" "$ssh" "$temps" "$gpu" "$blk" \
        "$swap_total" "$swap_free" "$swap_file_size" "$data_total" "$data_used" "$data_avail"
    exit 0
fi

# ===== POST =====
[ "${REQUEST_METHOD:-GET}" = POST ] || { printf '{"error":"method not allowed"}\n'; exit 0; }
length=${CONTENT_LENGTH:-0}
case "$length" in ''|*[!0-9]*) printf '{"error":"invalid content length"}\n'; exit 0;; esac
[ "$length" -le 8192 ] || { printf '{"error":"request body too large"}\n'; exit 0; }
body=$(dd bs=1 count="$length" 2>/dev/null)
action=$(printf '%s' "$body" | sed -n 's/.*"action"[[:space:]]*:[[:space:]]*"\([A-Za-z_-]*\)".*/\1/p')

case "$action" in
    create_swap)
        size_mib=$(printf '%s' "$body" | sed -n 's/.*"size_mib"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        case "$size_mib" in 512|1024|2048|4096|8192|16384) ;; *) printf '{"error":"unsupported swap size"}\n'; exit 0 ;; esac
        command -v mkswap >/dev/null 2>&1 || { printf '{"error":"mkswap is unavailable"}\n'; exit 0; }
        mkdir -p "$(dirname "$SWAP_FILE")"
        available_kib=$(df -Pk "$(dirname "$SWAP_FILE")" 2>/dev/null | awk 'NR==2{print $4}')
        required_kib=$((size_mib * 1024))
        [ "${available_kib:-0}" -gt "$((required_kib + 65536))" ] || { printf '{"error":"insufficient persistent storage"}\n'; exit 0; }
        if awk -v path="$SWAP_FILE" 'NR>1 && $1==path{found=1}END{exit !found}' /proc/swaps 2>/dev/null; then
            swapoff "$SWAP_FILE" 2>/dev/null || { printf '{"error":"not enough memory to deactivate the existing swap file"}\n'; exit 0; }
        fi
        temporary="$SWAP_FILE.new.$$"
        rm -f "$temporary"
        if command -v fallocate >/dev/null 2>&1; then
            fallocate -l "${size_mib}M" "$temporary" 2>/dev/null || rm -f "$temporary"
        fi
        if [ ! -f "$temporary" ]; then
            dd if=/dev/zero of="$temporary" bs=1M count="$size_mib" status=none 2>/dev/null || { rm -f "$temporary"; printf '{"error":"failed to allocate swap file"}\n'; exit 0; }
        fi
        chmod 0600 "$temporary"
        mkswap "$temporary" >/dev/null 2>&1 || { rm -f "$temporary"; printf '{"error":"mkswap failed"}\n'; exit 0; }
        mv "$temporary" "$SWAP_FILE"
        swapon "$SWAP_FILE" 2>/dev/null || { printf '{"error":"swap file created but activation failed"}\n'; exit 0; }
        printf '{"success":true,"action":"create_swap","path":"%s","size_mib":%s}\n' "$SWAP_FILE" "$size_mib"
        ;;
    set_volume_size)
        component=$(printf '%s' "$body" | sed -n 's/.*"component"[[:space:]]*:[[:space:]]*"\([a-z0-9-]*\)".*/\1/p')
        volume_id=$(printf '%s' "$body" | sed -n 's/.*"volume_id"[[:space:]]*:[[:space:]]*"\([a-z0-9-]*\)".*/\1/p')
        new_size=$(printf '%s' "$body" | sed -n 's/.*"size_mib"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        awk -F '\t' -v c="$component" -v i="$volume_id" '$1==c && $2==i{found=1} END{exit !found}' /run/strataos/volumes.tsv 2>/dev/null || { printf '{"error":"component volume is not active"}\n'; exit 0; }
        case "$new_size" in ''|0|*[!0-9]*) printf '{"error":"invalid size"}\n'; exit 0;; esac
        volume_line=$(awk -F '\t' -v c="$component" -v i="$volume_id" '$1==c && $2==i{print;exit}' /run/strataos/volumes.tsv)
        mount_path=$(printf '%s\n' "$volume_line" | awk -F '\t' '{print $5}')
        backing=$(printf '%s\n' "$volume_line" | awk -F '\t' '{print $6}'); backing=${backing%%,*}
        backing_bytes=$(stat -c %s "$backing" 2>/dev/null || echo 0)
        cur_size=$((backing_bytes / 1024 / 1024))
        [ "$cur_size" -gt 0 ] || cur_size=$(df -Pk "$mount_path" 2>/dev/null | awk 'NR==2{print int($2/1024)}')
        cur_size=${cur_size:-0}
        if [ "$new_size" -lt "$cur_size" ]; then
            printf '{"error":"volume size can only be increased (min: %s MiB)"}\n' "$cur_size"; exit 0
        fi
        if [ -n "$mount_path" ] && [ -d "$mount_path" ]; then
            current_total_kib=$(df -Pk "$mount_path" 2>/dev/null | awk 'NR==2{print $2}')
            current_mib=$((current_total_kib / 1024))
            if [ "$new_size" -lt "$current_mib" ]; then
                printf '{"error":"cannot shrink (disk: %s MiB)"}\n' "$current_mib"; exit 0
            fi
        fi
        kv_set "$VOLUME_CONF" "override.${component}.${volume_id}.size_mib" "$new_size"
        printf '{"success":true,"action":"set_volume_size","component":"%s","volume_id":"%s","size_mib":%s}\n' "$component" "$volume_id" "$new_size"
        ;;
    set_growth)
        component=$(printf '%s' "$body" | sed -n 's/.*"component"[[:space:]]*:[[:space:]]*"\([a-z0-9-]*\)".*/\1/p')
        volume_id=$(printf '%s' "$body" | sed -n 's/.*"volume_id"[[:space:]]*:[[:space:]]*"\([a-z0-9-]*\)".*/\1/p')
        growth=$(printf '%s' "$body" | sed -n 's/.*"growth"[[:space:]]*:[[:space:]]*"\([A-Za-z-]*\)".*/\1/p')
        awk -F '\t' -v c="$component" -v i="$volume_id" '$1==c && $2==i{found=1} END{exit !found}' /run/strataos/volumes.tsv 2>/dev/null || { printf '{"error":"component volume is not active"}\n'; exit 0; }
        case "$growth" in boot-only|grow-only|fixed|inherit) : ;; *) printf '{"error":"invalid growth"}\n'; exit 0;; esac
        kv_set "$VOLUME_CONF" "override.${component}.${volume_id}.growth" "$growth"
        printf '{"success":true,"action":"set_growth","component":"%s","volume_id":"%s","growth":"%s"}\n' "$component" "$volume_id" "$growth"
        ;;
    docker_config)
        data_root=$(printf '%s' "$body" | sed -n 's/.*"data_root"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
        log_size=$(printf '%s' "$body" | sed -n 's/.*"log_max_size"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
        log_file=$(printf '%s' "$body" | sed -n 's/.*"log_max_file"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
        log_driver=$(printf '%s' "$body" | sed -n 's/.*"log_driver"[[:space:]]*:[[:space:]]*"\([a-z-]*\)".*/\1/p')
        log_level=$(printf '%s' "$body" | sed -n 's/.*"log_level"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')
        live_restore=$(printf '%s' "$body" | sed -n 's/.*"live_restore"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p')
        userland_proxy=$(printf '%s' "$body" | sed -n 's/.*"userland_proxy"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p')
        auto_start=$(printf '%s' "$body" | sed -n 's/.*"auto_start"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p')
        [ -f /etc/docker/daemon.json ] || { printf '{"error":"docker not installed"}\n'; exit 0; }
        case "$data_root" in ''|/*) ;; *) printf '{"error":"data root must be an absolute path"}\n'; exit 0 ;; esac
        case "$data_root" in *[!A-Za-z0-9_./-]*) printf '{"error":"data root contains unsupported characters"}\n'; exit 0 ;; esac
        case "$log_size" in ''|*[!0-9kKmMgG]) printf '{"error":"invalid log size"}\n'; exit 0 ;; esac
        case "$log_file" in ''|*[!0-9]*) printf '{"error":"invalid log file count"}\n'; exit 0 ;; esac
        case "$log_driver" in ''|local|json-file) ;; *) printf '{"error":"invalid log driver"}\n'; exit 0 ;; esac
        case "$log_level" in ''|debug|info|warn|error|fatal) ;; *) printf '{"error":"invalid log level"}\n'; exit 0 ;; esac
        mkdir -p /etc/strataos
        [ -z "$data_root" ] || kv_set /etc/strataos/docker.conf data_root "$data_root"
        [ -z "$log_size" ] || kv_set /etc/strataos/docker.conf log_max_size "$log_size"
        [ -z "$log_file" ] || kv_set /etc/strataos/docker.conf log_max_file "$log_file"
        [ -z "$log_driver" ] || kv_set /etc/strataos/docker.conf log_driver "$log_driver"
        [ -z "$log_level" ] || kv_set /etc/strataos/docker.conf log_level "$log_level"
        [ -z "$live_restore" ] || kv_set /etc/strataos/docker.conf live_restore "$live_restore"
        [ -z "$userland_proxy" ] || kv_set /etc/strataos/docker.conf userland_proxy "$userland_proxy"
        if [ -n "$auto_start" ] && command -v rc-update >/dev/null 2>&1; then
            if [ "$auto_start" = true ]; then rc-update add docker default >/dev/null 2>&1 || true
            else rc-update del docker default >/dev/null 2>&1 || true; fi
        fi
        result=$(/usr/libexec/strataos/web-docker-config 2>&1) || { printf '{"error":"%s"}\n' "$(escape "$result")"; exit 0; }
        if command -v rc-service >/dev/null 2>&1 && rc-service docker status >/dev/null 2>&1; then
            result=$(rc-service docker restart 2>&1) || { printf '{"error":"%s"}\n' "$(escape "$result")"; exit 0; }
        fi
        printf '{"success":true,"action":"docker_config","restarted":true}\n'
        ;;
    logging_mode)
        mode=$(printf '%s' "$body" | sed -n 's/.*"mode"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p')
        case "$mode" in persistent|volatile) : ;; *) printf '{"error":"invalid mode"}\n'; exit 0;; esac
        [ -f /etc/conf.d/strataos-logging ] && sed -i "s/^mode=.*/mode=$mode/" /etc/conf.d/strataos-logging 2>/dev/null
        printf '{"success":true,"action":"logging_mode","mode":"%s"}\n' "$mode"
        ;;
    kernel_tuning)
        cc=$(printf '%s' "$body" | sed -n 's/.*"tcp_congestion"[[:space:]]*:[[:space:]]*"\([a-z_]*\)".*/\1/p')
        qdisc=$(printf '%s' "$body" | sed -n 's/.*"qdisc"[[:space:]]*:[[:space:]]*"\([a-z_]*\)".*/\1/p')
        tfo=$(printf '%s' "$body" | sed -n 's/.*"tcp_fastopen"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        swappiness=$(printf '%s' "$body" | sed -n 's/.*"swappiness"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        swap_state=$(printf '%s' "$body" | sed -n 's/.*"swap_state"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')
        mtu_probing=$(printf '%s' "$body" | sed -n 's/.*"tcp_mtu_probing"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        ipv4_forward=$(printf '%s' "$body" | sed -n 's/.*"ipv4_forward"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        rp_filter=$(printf '%s' "$body" | sed -n 's/.*"rp_filter"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        mkdir -p /etc/sysctl.d
        if [ -f "$SYSCTL_CONF" ]; then cp "$SYSCTL_CONF" "$SYSCTL_CONF.tmp"; else : > "$SYSCTL_CONF.tmp"; fi
        if [ -n "$cc" ]; then
            case "$cc" in bbr|cubic|reno) : ;; *) printf '{"error":"invalid congestion control"}\n'; exit 0 ;; esac
            kv_set "$SYSCTL_CONF.tmp" net.ipv4.tcp_congestion_control "$cc"
        fi
        if [ -n "$qdisc" ]; then
            case "$qdisc" in fq|fq_codel|pfifo_fast|cake) : ;; *) printf '{"error":"invalid qdisc"}\n'; exit 0 ;; esac
            kv_set "$SYSCTL_CONF.tmp" net.core.default_qdisc "$qdisc"
        fi
        if [ -n "$tfo" ]; then
            case "$tfo" in 0|1|2|3) : ;; *) printf '{"error":"invalid tfo"}\n'; exit 0 ;; esac
            kv_set "$SYSCTL_CONF.tmp" net.ipv4.tcp_fastopen "$tfo"
        fi
        if [ -n "$swappiness" ]; then
            case "$swappiness" in ''|*[!0-9]*) printf '{"error":"invalid swappiness"}\n'; exit 0 ;; esac
            [ "$swappiness" -ge 0 ] && [ "$swappiness" -le 100 ] || { printf '{"error":"swappiness 0-100"}\n'; exit 0; }
            kv_set "$SYSCTL_CONF.tmp" vm.swappiness "$swappiness"
        fi
        if [ -n "$mtu_probing" ]; then
            case "$mtu_probing" in 0|1|2) ;; *) printf '{"error":"invalid TCP MTU probing mode"}\n'; exit 0 ;; esac
            kv_set "$SYSCTL_CONF.tmp" net.ipv4.tcp_mtu_probing "$mtu_probing"
        fi
        if [ -n "$ipv4_forward" ]; then
            case "$ipv4_forward" in 0|1) ;; *) printf '{"error":"invalid IPv4 forwarding mode"}\n'; exit 0 ;; esac
            kv_set "$SYSCTL_CONF.tmp" net.ipv4.ip_forward "$ipv4_forward"
        fi
        if [ -n "$rp_filter" ]; then
            case "$rp_filter" in 0|1|2) ;; *) printf '{"error":"invalid reverse path filter mode"}\n'; exit 0 ;; esac
            kv_set "$SYSCTL_CONF.tmp" net.ipv4.conf.all.rp_filter "$rp_filter"
        fi
        if [ -n "$swap_state" ]; then
            case "$swap_state" in
                on) swapon -a 2>/dev/null || true ;;
                off) swapoff -a 2>/dev/null || true ;;
                *) printf '{"error":"invalid swap state"}\n'; exit 0 ;;
            esac
        fi
        if [ -s "$SYSCTL_CONF.tmp" ]; then
            mv "$SYSCTL_CONF.tmp" "$SYSCTL_CONF"
            sysctl -p "$SYSCTL_CONF" >/dev/null 2>&1 || true
        else
            rm -f "$SYSCTL_CONF.tmp"
        fi
        printf '{"success":true,"action":"kernel_tuning"}\n'
        ;;
    ssh_service)
        requested=$(printf '%s' "$body" | sed -n 's/.*"enabled"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p')
        [ -x /usr/sbin/sshd ] && [ -f /etc/init.d/sshd ] || { printf '{"error":"OpenSSH component is unavailable"}\n'; exit 0; }
        case "$requested" in
            true)
                rc-update add sshd default >/dev/null 2>&1 || { printf '{"error":"failed to enable SSH at boot"}\n'; exit 0; }
                [ ! -f /etc/init.d/fail2ban ] || rc-update add fail2ban default >/dev/null 2>&1 || true
                result=$(rc-service sshd start 2>&1) || {
                    rc-update del sshd default >/dev/null 2>&1 || true
                    [ ! -f /etc/init.d/fail2ban ] || rc-update del fail2ban default >/dev/null 2>&1 || true
                    printf '{"error":"%s"}\n' "$(escape "$result")"
                    exit 0
                }
                [ ! -f /etc/init.d/fail2ban ] || rc-service fail2ban start >/dev/null 2>&1 || true
                ;;
            false)
                [ ! -f /etc/init.d/fail2ban ] || rc-service fail2ban stop >/dev/null 2>&1 || true
                result=$(rc-service sshd stop 2>&1) || { printf '{"error":"%s"}\n' "$(escape "$result")"; exit 0; }
                rc-update del sshd default >/dev/null 2>&1 || true
                [ ! -f /etc/init.d/fail2ban ] || rc-update del fail2ban default >/dev/null 2>&1 || true
                ;;
            *) printf '{"error":"invalid SSH service state"}\n'; exit 0 ;;
        esac
        printf '{"success":true,"action":"ssh_service","enabled":%s}\n' "$requested"
        ;;
    ssh_config)
        port=$(printf '%s' "$body" | sed -n 's/.*"port"[[:space:]]*:[[:space:]]*"\([0-9]*\)".*/\1/p')
        permit_root=$(printf '%s' "$body" | sed -n 's/.*"permit_root_login"[[:space:]]*:[[:space:]]*"\([a-z-]*\)".*/\1/p')
        password_auth=$(printf '%s' "$body" | sed -n 's/.*"password_auth"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')
        tcp_fwd=$(printf '%s' "$body" | sed -n 's/.*"tcp_forwarding"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')
        max_auth=$(printf '%s' "$body" | sed -n 's/.*"max_auth_tries"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        idle_interval=$(printf '%s' "$body" | sed -n 's/.*"client_alive_interval"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        idle_count=$(printf '%s' "$body" | sed -n 's/.*"client_alive_count_max"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
        case "$port" in ''|*[!0-9]*) [ -z "$port" ] || { printf '{"error":"invalid SSH port"}\n'; exit 0; } ;; esac
        [ -z "$port" ] || { [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } || { printf '{"error":"invalid SSH port"}\n'; exit 0; }
        case "$max_auth" in ''|*[!0-9]*) [ -z "$max_auth" ] || { printf '{"error":"invalid MaxAuthTries"}\n'; exit 0; } ;; esac
        mkdir -p /etc/ssh/sshd_config.d
        # Build new config file
        {
            [ -n "$port" ] && printf 'Port %s\n' "$port"
            [ -n "$permit_root" ] && printf 'PermitRootLogin %s\n' "$permit_root"
            [ -n "$password_auth" ] && printf 'PasswordAuthentication %s\n' "$password_auth"
            [ -n "$tcp_fwd" ] && printf 'AllowTcpForwarding %s\n' "$tcp_fwd"
            [ -n "$max_auth" ] && printf 'MaxAuthTries %s\n' "$max_auth"
            [ -n "$idle_interval" ] && printf 'ClientAliveInterval %s\n' "$idle_interval"
            [ -n "$idle_count" ] && printf 'ClientAliveCountMax %s\n' "$idle_count"
            printf 'HostKey /var/lib/strataos/openssh/ssh_host_ed25519_key\n'
            printf 'HostKey /var/lib/strataos/openssh/ssh_host_rsa_key\n'
            printf 'UseDNS no\nX11Forwarding no\n'
        } > "$SSHD_CONF.tmp"
        # Validate the candidate before replacing the last known-good file.
        if /usr/sbin/sshd -t -f "$SSHD_CONF.tmp" 2>/dev/null; then
            mv "$SSHD_CONF.tmp" "$SSHD_CONF"
            printf '{"success":true,"action":"ssh_config","restart_required":true}\n'
        else
            rm -f "$SSHD_CONF.tmp"
            printf '{"error":"OpenSSH rejected the proposed configuration"}\n'
        fi
        ;;
    *)
        printf '{"error":"invalid action: %s"}\n' "$(escape "$action")"
        ;;
esac
