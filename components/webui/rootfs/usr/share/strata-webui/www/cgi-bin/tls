#!/bin/sh
. /usr/libexec/strataos/webui-cgi-common
require_auth
json_headers

directory=/etc/strataos/webui
config=$directory/tls.conf
certificate=$directory/tls.crt
private_key=$directory/tls.key

fail() {
    printf '{"error":"%s"}\n' "$(printf '%s' "$1" | json_escape)"
    exit 0
}

json_value() {
    printf '%s' "$body" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
}

restart_webui() {
    (sleep 2; rc-service strata-webui restart) >/dev/null 2>&1 &
}

certificate_status() {
    enabled=false
    grep -qx 'enabled=yes' "$config" 2>/dev/null && enabled=true
    configured=false
    subject=
    issuer=
    not_before=
    not_after=
    fingerprint=
    self_signed=false
    if [ -s "$certificate" ] && openssl x509 -in "$certificate" -noout >/dev/null 2>&1; then
        configured=true
        subject=$(openssl x509 -in "$certificate" -noout -subject 2>/dev/null | sed 's/^subject=//')
        issuer=$(openssl x509 -in "$certificate" -noout -issuer 2>/dev/null | sed 's/^issuer=//')
        not_before=$(openssl x509 -in "$certificate" -noout -startdate 2>/dev/null | sed 's/^notBefore=//')
        not_after=$(openssl x509 -in "$certificate" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')
        fingerprint=$(openssl x509 -in "$certificate" -noout -fingerprint -sha256 2>/dev/null | sed 's/^[^=]*=//')
        [ "$subject" != "$issuer" ] || self_signed=true
    fi
    printf '{"enabled":%s,"configured":%s,"self_signed":%s,"subject":"%s","issuer":"%s","not_before":"%s","not_after":"%s","fingerprint":"%s"}\n' \
        "$enabled" "$configured" "$self_signed" \
        "$(printf '%s' "$subject" | json_escape)" "$(printf '%s' "$issuer" | json_escape)" \
        "$(printf '%s' "$not_before" | json_escape)" "$(printf '%s' "$not_after" | json_escape)" \
        "$(printf '%s' "$fingerprint" | json_escape)"
}

install_pair() {
    candidate_certificate=$1
    candidate_key=$2
    openssl x509 -in "$candidate_certificate" -noout >/dev/null 2>&1 || fail "invalid PEM certificate or certificate chain"
    openssl pkey -in "$candidate_key" -passin pass: -noout >/dev/null 2>&1 || fail "invalid or encrypted PEM private key"
    openssl x509 -in "$candidate_certificate" -checkend 0 -noout >/dev/null 2>&1 || fail "certificate is expired or not currently valid"
    certificate_public=$(openssl x509 -in "$candidate_certificate" -pubkey -noout 2>/dev/null |
        openssl pkey -pubin -outform DER 2>/dev/null | openssl dgst -sha256 2>/dev/null) || fail "unable to read certificate public key"
    key_public=$(openssl pkey -in "$candidate_key" -passin pass: -pubout -outform DER 2>/dev/null |
        openssl dgst -sha256 2>/dev/null) || fail "unable to read private key"
    [ -n "$certificate_public" ] && [ "$certificate_public" = "$key_public" ] || fail "certificate and private key do not match"
    install -m 0644 -o root -g root "$candidate_certificate" "$certificate" || fail "unable to install certificate"
    install -m 0600 -o root -g root "$candidate_key" "$private_key" || fail "unable to install private key"
    printf 'enabled=yes\n' > "$config.tmp.$$" || fail "unable to write TLS configuration"
    chmod 0600 "$config.tmp.$$"
    mv "$config.tmp.$$" "$config"
}

case "${REQUEST_METHOD:-GET}" in
    GET)
        certificate_status
        ;;
    POST)
        length=${CONTENT_LENGTH:-0}
        case "$length" in ''|*[!0-9]*) fail "invalid content length" ;; esac
        [ "$length" -le 262144 ] || fail "request body too large"
        body=$(dd bs=1 count="$length" 2>/dev/null)
        action=$(json_value action)
        mkdir -p "$directory" || fail "unable to create TLS configuration directory"
        chmod 0700 "$directory"
        temporary_certificate=$directory/tls.crt.tmp.$$
        temporary_key=$directory/tls.key.tmp.$$
        trap 'rm -f "$temporary_certificate" "$temporary_key" "$config.tmp.$$"' EXIT
        case "$action" in
            self-signed)
                common_name=$(json_value common_name)
                days=$(json_value days)
                case "$common_name" in ''|-*|*[!A-Za-z0-9.-]*) fail "invalid hostname or IP address" ;; esac
                case "$days" in ''|*[!0-9]*) fail "validity must be a number of days" ;; esac
                [ "$days" -ge 1 ] && [ "$days" -le 3650 ] || fail "validity must be between 1 and 3650 days"
                case "$common_name" in
                    *[!0-9.]*) subject_alt_name="DNS:$common_name" ;;
                    *) subject_alt_name="IP:$common_name" ;;
                esac
                openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days "$days" \
                    -subj "/CN=$common_name" -addext "subjectAltName=$subject_alt_name" \
                    -keyout "$temporary_key" -out "$temporary_certificate" >/dev/null 2>&1 ||
                    fail "unable to generate self-signed certificate"
                install_pair "$temporary_certificate" "$temporary_key"
                restart_webui
                printf '{"ok":true,"enabled":true,"restart":true}\n'
                ;;
            deploy)
                certificate_data=$(json_value certificate)
                private_key_data=$(json_value private_key)
                [ -n "$certificate_data" ] && [ -n "$private_key_data" ] || fail "certificate and private key are required"
                printf '%s' "$certificate_data" | openssl base64 -d -A > "$temporary_certificate" 2>/dev/null || fail "invalid certificate encoding"
                printf '%s' "$private_key_data" | openssl base64 -d -A > "$temporary_key" 2>/dev/null || fail "invalid private key encoding"
                install_pair "$temporary_certificate" "$temporary_key"
                restart_webui
                printf '{"ok":true,"enabled":true,"restart":true}\n'
                ;;
            disable)
                printf 'enabled=no\n' > "$config.tmp.$$" || fail "unable to write TLS configuration"
                chmod 0600 "$config.tmp.$$"
                mv "$config.tmp.$$" "$config"
                restart_webui
                printf '{"ok":true,"enabled":false,"restart":true}\n'
                ;;
            enable)
                [ -s "$certificate" ] && [ -s "$private_key" ] || fail "no certificate has been deployed"
                cp "$certificate" "$temporary_certificate" || fail "unable to read installed certificate"
                cp "$private_key" "$temporary_key" || fail "unable to read installed private key"
                install_pair "$temporary_certificate" "$temporary_key"
                restart_webui
                printf '{"ok":true,"enabled":true,"restart":true}\n'
                ;;
            *) fail "invalid action" ;;
        esac
        ;;
    *) fail "method not allowed" ;;
esac
