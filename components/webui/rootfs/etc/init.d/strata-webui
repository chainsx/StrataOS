#!/sbin/openrc-run

name="StrataOS Web UI"
description="Core system control and browser terminal service"
command=/usr/sbin/httpd
tls_config=/etc/strataos/webui/tls.conf
tls_certificate=/etc/strataos/webui/tls.crt
tls_private_key=/etc/strataos/webui/tls.key
if grep -qx 'enabled=yes' "$tls_config" 2>/dev/null &&
    [ -s "$tls_certificate" ] && [ -s "$tls_private_key" ]; then
    command_args="-f -p 127.0.0.1:9091 -h /usr/share/strata-webui/www"
else
    command_args="-f -p 9090 -h /usr/share/strata-webui/www"
fi
supervisor=supervise-daemon
pidfile=/run/openrc/strata-webui-supervise.pid
output_log=/var/log/strata-webui.log
error_log=/var/log/strata-webui.log

depend() {
    need localmount strataos-storage dbus
    use net logger
    after strataos-network strataos-logging
}

start_pre() {
    mkdir -p /etc/strataos/webui
    checkpath --directory --owner root:root --mode 0700 /etc/strataos/webui
    if [ -x /usr/libexec/strataos/web-flatpak-session ]; then
        checkpath --directory --owner root:webapp --mode 0750 /var/lib/strataos/webui
        checkpath --directory --owner webapp:webapp --mode 0700 /var/lib/strataos/webui/home
        chown root:webapp /var/lib/strataos/webui
        chmod 0750 /var/lib/strataos/webui
        chown -R webapp:webapp /var/lib/strataos/webui/home
    fi
    checkpath --directory --mode 0755 /run/strata-webui
    checkpath --directory --mode 0700 /run/strata-webui/docker-terminals
    checkpath --directory --mode 0700 /run/strata-webui/auth-sessions
    checkpath --file --mode 0640 /var/log/strata-webui.log
    tls=no
    if grep -qx 'enabled=yes' "$tls_config" 2>/dev/null &&
        [ -s "$tls_certificate" ] && [ -s "$tls_private_key" ]; then
        tls=yes
        start-stop-daemon --start --background --make-pidfile \
            --pidfile /run/strata-webui/tls-http.pid \
            --exec /usr/sbin/strata-tlsproxy -- \
            -l 9090 -b 9091 -c "$tls_certificate" -k "$tls_private_key"
    fi
    start-stop-daemon --start --background --make-pidfile \
        --pidfile /run/strata-webui/ttyd.pid \
        --exec /usr/bin/ttyd -- \
        -i 127.0.0.1 -p 7682 -W -m 1 \
        -H X-Strata-Authenticated -t disableLeaveAlert=true \
        /bin/zsh -l
    terminal_port=7681
    terminal_bind_args=
    if [ "$tls" = yes ]; then
        terminal_port=7683
        terminal_bind_args="-i 127.0.0.1"
    fi
    start-stop-daemon --start --background --make-pidfile \
        --pidfile /run/strata-webui/authproxy.pid \
        --exec /usr/sbin/strata-authproxy -- \
        -l "$terminal_port" $terminal_bind_args -b 7682 -t /run/strata-webui/auth-sessions
    if [ "$tls" = yes ]; then
        start-stop-daemon --start --background --make-pidfile \
            --pidfile /run/strata-webui/tls-terminal.pid \
            --exec /usr/sbin/strata-tlsproxy -- \
            -l 7681 -b 7683 -c "$tls_certificate" -k "$tls_private_key"
    fi
}

stop_post() {
    /usr/libexec/strataos/web-flatpak-session stop-all >/dev/null 2>&1 || true
    /usr/libexec/strataos/web-flatpak-services stop >/dev/null 2>&1 || true
    /usr/libexec/strataos/web-docker-terminal stop-all >/dev/null 2>&1 || true
    start-stop-daemon --stop --pidfile /run/strata-webui/authproxy.pid --retry TERM/3/KILL/2 || true
    start-stop-daemon --stop --pidfile /run/strata-webui/ttyd.pid --retry TERM/3/KILL/2 || true
    start-stop-daemon --stop --pidfile /run/strata-webui/wsproxy.pid --retry TERM/3/KILL/2 || true
    start-stop-daemon --stop --pidfile /run/strata-webui/tls-http.pid --retry TERM/3/KILL/2 || true
    start-stop-daemon --stop --pidfile /run/strata-webui/tls-vnc.pid --retry TERM/3/KILL/2 || true
    start-stop-daemon --stop --pidfile /run/strata-webui/tls-terminal.pid --retry TERM/3/KILL/2 || true
    rm -f /run/strata-webui/authproxy.pid /run/strata-webui/ttyd.pid /run/strata-webui/wsproxy.pid
    rm -f /run/strata-webui/tls-http.pid /run/strata-webui/tls-vnc.pid /run/strata-webui/tls-terminal.pid
    rm -f /run/strata-webui/auth-sessions/*
}
