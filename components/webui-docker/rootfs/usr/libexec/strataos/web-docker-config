#!/bin/sh
# Owned by the webui-docker capability component.
set -eu

list=/etc/docker/registry-mirrors.list
settings=/etc/strataos/docker.conf
target=/etc/docker/daemon.json
temporary=$target.tmp.$$
trap 'rm -f "$temporary"' EXIT

get_setting() {
    value=$(awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$settings" 2>/dev/null || true)
    printf '%s' "${value:-$2}"
}

data_root=$(get_setting data_root /var/lib/docker)
log_driver=$(get_setting log_driver local)
log_max_size=$(get_setting log_max_size 10m)
log_max_file=$(get_setting log_max_file 3)
log_level=$(get_setting log_level info)
live_restore=$(get_setting live_restore false)
userland_proxy=$(get_setting userland_proxy false)

case "$data_root" in /*) ;; *) echo "invalid Docker data root" >&2; exit 2 ;; esac
case "$data_root" in *[!A-Za-z0-9_./-]*) echo "invalid Docker data root" >&2; exit 2 ;; esac
case "$log_driver" in local|json-file) ;; *) echo "invalid Docker log driver" >&2; exit 2 ;; esac
case "$log_max_size" in *[!0-9kKmMgG]|'') echo "invalid Docker log size" >&2; exit 2 ;; esac
case "$log_max_file" in ''|*[!0-9]*) echo "invalid Docker log file count" >&2; exit 2 ;; esac
case "$log_level" in debug|info|warn|error|fatal) ;; *) echo "invalid Docker log level" >&2; exit 2 ;; esac
case "$live_restore:$userland_proxy" in true:true|true:false|false:true|false:false) ;; *) echo "invalid Docker boolean setting" >&2; exit 2 ;; esac

mkdir -p "$(dirname "$target")"
mkdir -p "$data_root"
chmod 0711 "$data_root"
{
    printf '{\n'
    printf '  "data-root": "%s",\n' "$data_root"
    printf '  "storage-driver": "overlay2",\n'
    printf '  "log-driver": "%s",\n' "$log_driver"
    printf '  "log-opts": {"max-size": "%s", "max-file": "%s"},\n' "$log_max_size" "$log_max_file"
    printf '  "log-level": "%s",\n' "$log_level"
    printf '  "live-restore": %s,\n' "$live_restore"
    printf '  "userland-proxy": %s,\n' "$userland_proxy"
    # StrataOS owns forwarding through nftables, so Docker must not mutate
    # the firewall or create its unmanaged default bridge.
    printf '  "iptables": false,\n  "ip6tables": false,\n  "bridge": "none",\n'
    printf '  "registry-mirrors": ['
    first=yes
    while IFS= read -r mirror; do
        case "$mirror" in ''|'#'*) continue ;; esac
        [ "$first" = yes ] || printf ', '
        first=no
        printf '"%s"' "$mirror"
    done < "$list" 2>/dev/null || true
    printf ']\n}\n'
} > "$temporary"

if command -v dockerd >/dev/null 2>&1; then
    dockerd --validate --config-file "$temporary" >/dev/null 2>&1 || {
        echo "Docker rejected the generated daemon configuration" >&2
        exit 3
    }
fi
mv "$temporary" "$target"
trap - EXIT
