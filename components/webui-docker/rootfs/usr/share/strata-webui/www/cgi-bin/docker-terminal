#!/bin/sh
# Owned by the webui-docker capability component.
. /usr/libexec/strataos/webui-cgi-common
require_auth

length=${CONTENT_LENGTH:-0}
case "$length" in ''|*[!0-9]*) length=0 ;; esac
[ "$length" -le 4096 ] || length=0
body=$(dd bs=1 count="$length" 2>/dev/null)
id=$(printf '%s' "$body" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9_.-]*\)".*/\1/p')
if port=$(/usr/libexec/strataos/web-docker-terminal start "$id" 2>&1); then
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n'
    printf 'Set-Cookie: strata_terminal=%s; Path=/; HttpOnly; SameSite=Strict\r\n\r\n' "$AUTH_TOKEN"
    printf '{"port":%s}\n' "$port"
else
    json_headers
    printf '{"error":"%s"}\n' "$(printf '%s' "$port" | json_escape)"
fi
