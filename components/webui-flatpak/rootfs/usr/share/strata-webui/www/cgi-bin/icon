#!/bin/sh
# Owned by the webui-flatpak capability component.
. /usr/libexec/strataos/webui-cgi-common
require_auth

app=$(printf '%s' "${QUERY_STRING:-}" | sed -n 's/^app_id=\([A-Za-z0-9._-]*\)$/\1/p')
case "$app" in ''|-*|*[!A-Za-z0-9._-]*) app= ;; esac
icon=
type=
if [ -n "$app" ]; then
    icon=$(/usr/libexec/strataos/web-flatpak-icon "$app" 2>/dev/null || true)
fi
case "$icon" in
    *.png) type=image/png ;;
    *.svg) type=image/svg+xml ;;
esac
if [ -n "$type" ]; then
    printf 'Content-Type: %s\r\nCache-Control: private, max-age=300\r\nX-Content-Type-Options: nosniff\r\n\r\n' "$type"
    cat "$icon"
else
    printf 'Status: 404 Not Found\r\nContent-Type: text/plain\r\nCache-Control: no-store\r\n\r\nicon not found\n'
fi
