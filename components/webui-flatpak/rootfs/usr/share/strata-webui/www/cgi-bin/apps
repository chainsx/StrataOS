#!/bin/sh
# Owned by the webui-flatpak capability component.
. /usr/libexec/strataos/webui-cgi-common
require_auth
json_headers

printf '['
first=yes
sessions_file=$(mktemp /run/strata-webui/apps-sessions.XXXXXX) || exit 1
trap 'rm -f "$sessions_file"' EXIT HUP INT TERM
/usr/libexec/strataos/web-flatpak-session status > "$sessions_file" 2>/dev/null || :
flatpak list --system --app --columns=application,name,version 2>/dev/null |
while IFS="$(printf '\t')" read -r app name version; do
    case "$app" in ''|*[!A-Za-z0-9._-]*) continue ;; esac
    state=stopped
    render_mode=unknown
    while IFS="$(printf '\t')" read -r session_app session_state session_port session_mode; do
        [ "$session_app" = "$app" ] || continue
        state=$session_state
        render_mode=$session_mode
        break
    done < "$sessions_file"
    case "$render_mode" in gpu|software|unknown) ;; *) render_mode=unknown ;; esac
    running=false
    sessions_count=0
    if [ "$state" = running ]; then running=true; sessions_count=1; fi
    icon_url=
    if /usr/libexec/strataos/web-flatpak-icon "$app" >/dev/null 2>&1; then
        icon_url="/cgi-bin/icon?app_id=$app"
    fi
    [ "$first" = yes ] || printf ','
    first=no
    printf '{"app_id":"%s","name":"%s","version":"%s","icon_url":"%s","session":{"running":%s,"render_mode":"%s"},"sessions_count":%s}' \
        "$(printf '%s' "$app" | json_escape)" "$(printf '%s' "${name:-$app}" | json_escape)" \
        "$(printf '%s' "$version" | json_escape)" "$(printf '%s' "$icon_url" | json_escape)" \
        "$running" "$render_mode" "$sessions_count"
done
printf ']\n'
