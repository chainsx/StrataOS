#!/bin/sh
# Owned by the webui-flatpak capability component.
. /usr/libexec/strataos/webui-cgi-common
require_auth
json_headers

read_body() {
    length=${CONTENT_LENGTH:-0}
    case "$length" in
        ''|*[!0-9]*) printf '{"error":"invalid content length"}\n'; exit 0 ;;
    esac
    [ "$length" -le 4096 ] || { printf '{"error":"request body too large"}\n'; exit 0; }
    dd bs=1 count="$length" 2>/dev/null
}

case "${REQUEST_METHOD:-GET}" in
    POST)
        body=$(read_body)
        action=$(printf '%s' "$body" | sed -n 's/.*"action"[[:space:]]*:[[:space:]]*"\([A-Za-z-]*\)".*/\1/p')
        app=$(printf '%s' "$body" | sed -n 's/.*"app_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9._-]*\)".*/\1/p')
        if [ "$action" = stop ]; then
            if result=$(/usr/libexec/strataos/web-flatpak-session stop "$app" 2>&1); then
                printf '{"state":"stopped","app_id":"%s"}\n' "$(printf '%s' "$app" | json_escape)"
            else
                printf '{"error":"%s"}\n' "$(printf '%s' "$result" | json_escape)"
            fi
            exit 0
        fi
        if result=$(/usr/libexec/strataos/web-flatpak-session start "$app" 2>&1); then
            old_ifs=$IFS
            IFS="$(printf '\t')"
            read -r app_id vnc_port render_mode <<EOF
$result
EOF
            IFS=$old_ifs
            printf '{"state":"running","app_id":"%s","render_mode":"%s","websocket_port":6080}\n' \
                "$(printf '%s' "$app_id" | json_escape)" "$render_mode"
        else
            printf '{"error":"%s"}\n' "$(printf '%s' "$result" | json_escape)"
        fi
        ;;
    GET)
        app=${QUERY_STRING#app_id=}
        if [ "$app" != "$QUERY_STRING" ]; then
            case "$app" in
                ''|*[!A-Za-z0-9._-]*) printf '{"error":"invalid application id"}\n'; exit 0 ;;
            esac
            old_ifs=$IFS
            IFS="$(printf '\t')"
            read -r app_id state port render_mode <<EOF
$(/usr/libexec/strataos/web-flatpak-session status "$app")
EOF
            IFS=$old_ifs
            printf '{"app_id":"%s","state":"%s","render_mode":"%s","websocket_port":6080}\n' \
                "$(printf '%s' "$app_id" | json_escape)" "$(printf '%s' "$state" | json_escape)" "$render_mode"
            exit 0
        fi
        printf '['
        first=yes
        /usr/libexec/strataos/web-flatpak-session status | while IFS="$(printf '\t')" read -r app_id state port render_mode; do
            [ -n "$app_id" ] || continue
            [ "$first" = yes ] || printf ','
            first=no
            printf '{"app_id":"%s","state":"%s","render_mode":"%s","websocket_port":6080}' \
                "$(printf '%s' "$app_id" | json_escape)" "$(printf '%s' "$state" | json_escape)" "$render_mode"
        done
        printf ']\n'
        ;;
    *) printf '{"error":"method not allowed"}\n' ;;
esac
