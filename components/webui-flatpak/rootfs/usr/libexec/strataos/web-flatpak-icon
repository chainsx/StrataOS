#!/bin/sh
# Resolve a Flatpak application's exported icon without trusting desktop metadata paths.
set -eu

app_id=${1:-}
case "$app_id" in
    ''|*[!A-Za-z0-9._-]*) exit 1 ;;
esac

share=/var/lib/flatpak/exports/share
desktop=$share/applications/$app_id.desktop
icon_name=
if [ -f "$desktop" ]; then
    icon_name=$(awk '
        /^\[Desktop Entry\]$/ { entry = 1; next }
        /^\[/ { if (entry) exit }
        entry && /^Icon=/ { sub(/^Icon=/, ""); print; exit }
    ' "$desktop")
    icon_name=${icon_name##*/}
    icon_name=${icon_name%.png}
    icon_name=${icon_name%.svg}
    icon_name=${icon_name%.xpm}
    case "$icon_name" in
        ''|*[!A-Za-z0-9._-]*) icon_name= ;;
    esac
fi

for name in "$icon_name" "$app_id"; do
    [ -n "$name" ] || continue
    for size in 512x512 256x256 128x128 64x64 48x48 scalable symbolic; do
        for extension in png svg; do
            candidate=$share/icons/hicolor/$size/apps/$name.$extension
            if [ -f "$candidate" ]; then
                printf '%s\n' "$candidate"
                exit 0
            fi
        done
    done
done
exit 1
