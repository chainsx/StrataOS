#!/bin/sh
# Owned by the webui-flatpak capability component.
set -eu

sessions=/run/strata-webui/sessions
ports=/run/strata-webui/vnc-ports
lock=/run/strata-webui/flatpak-session.lock
services=/usr/libexec/strataos/web-flatpak-services

valid_app() {
    case "$1" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
        *) return 0 ;;
    esac
}

session_render_mode() {
    local app_id mode
    app_id=$1
    mode=$(cat "$sessions/$app_id/render-mode" 2>/dev/null || true)
    case "$mode" in gpu|software) ;; *) mode=unknown ;; esac
    printf '%s\n' "$mode"
}

session_running() {
    local app_id pidfile startfile pid expected actual
    app_id=$1
    pidfile=$sessions/$app_id/pid
    startfile=$sessions/$app_id/start-time
    [ -s "$pidfile" ] && [ -s "$startfile" ] || return 1
    pid=$(cat "$pidfile" 2>/dev/null) || return 1
    expected=$(cat "$startfile" 2>/dev/null) || return 1
    actual=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null) || return 1
    [ -n "$expected" ] && [ "$actual" = "$expected" ] && kill -0 "$pid" 2>/dev/null
}

release_session() {
    local app_id directory pid port count
    app_id=$1
    directory=$sessions/$app_id
    pid=
    port=
    if session_running "$app_id"; then
        pid=$(cat "$directory/pid" 2>/dev/null || true)
    fi
    [ ! -s "$directory/vnc-port" ] || port=$(cat "$directory/vnc-port" 2>/dev/null || true)
    if [ -n "$pid" ]; then
        kill -TERM -"$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null; do
            count=$((count + 1))
            [ "$count" -lt 30 ] || break
            sleep 0.1
        done
        kill -KILL -"$pid" 2>/dev/null || true
    fi
    rm -rf "$directory"
    case "$port" in
        59[0-9][0-9]) rmdir "$ports/$port" 2>/dev/null || true ;;
    esac
}

allocate_port() {
    local port
    port=5900
    while [ "$port" -le 5999 ]; do
        if mkdir "$ports/$port" 2>/dev/null; then
            printf '%s\n' "$port"
            return 0
        fi
        port=$((port + 1))
    done
    return 1
}

stop_services_if_idle() {
    local directory item
    for directory in "$sessions"/*; do
        [ -d "$directory" ] || continue
        item=${directory##*/}
        valid_app "$item" || continue
        session_running "$item" && return 0
    done
    "$services" stop
}

acquire_lock() {
    local count owner
    count=0
    while ! ln -s "$$" "$lock" 2>/dev/null; do
        owner=$(readlink "$lock" 2>/dev/null || true)
        case "$owner" in
            ''|*[!0-9]*) rm -f "$lock" 2>/dev/null || true ;;
            *) kill -0 "$owner" 2>/dev/null || rm -f "$lock" 2>/dev/null || true ;;
        esac
        count=$((count + 1))
        [ "$count" -lt 200 ] || { echo "timed out waiting for the Flatpak session lock" >&2; exit 9; }
        sleep 0.1
    done
    trap release_lock EXIT
    trap 'exit 1' HUP INT TERM
}

release_lock() {
    [ "$(readlink "$lock" 2>/dev/null || true)" != "$$" ] || rm -f "$lock"
}

mkdir -p "$sessions" "$ports"
acquire_lock

case "${1:-}" in
    start)
        app_id=${2:-}
        valid_app "$app_id" || { echo "invalid application id" >&2; exit 2; }
        [ -x /usr/bin/setsid ] || { echo "required command is missing: /usr/bin/setsid" >&2; exit 4; }
        flatpak info "$app_id" >/dev/null 2>&1 || { echo "application is not installed" >&2; exit 3; }
        if session_running "$app_id"; then
            "$services" start
            current_mode=$(session_render_mode "$app_id")
            printf '%s\t%s\t%s\n' "$app_id" "$(cat "$sessions/$app_id/vnc-port")" "$current_mode"
            exit 0
        fi
        [ ! -e "$sessions/$app_id" ] || release_session "$app_id"
        mkdir "$sessions/$app_id" || { echo "application session is already starting" >&2; exit 7; }
        port=$(allocate_port) || {
            rmdir "$sessions/$app_id" 2>/dev/null || true
            echo "no graphical session ports are available" >&2
            exit 8
        }
        printf '%s\n' "$port" > "$sessions/$app_id/vnc-port"
        mkdir -p /var/lib/strataos/webui/home/.local/share \
            /var/lib/strataos/webui/home/.config \
            /var/lib/strataos/webui/home/.cache
        chown root:webapp /var/lib/strataos/webui
        chmod 0750 /var/lib/strataos/webui
        chown -R webapp:webapp /var/lib/strataos/webui/home
        chmod 0700 /var/lib/strataos/webui/home
        chmod 0755 "$sessions/$app_id"
        mkdir "$sessions/$app_id/runtime"
        chown webapp:webapp "$sessions/$app_id/runtime"
        chmod 0700 "$sessions/$app_id/runtime"
        if ! "$services" start; then
            release_session "$app_id"
            stop_services_if_idle
            exit 10
        fi
        /usr/bin/setsid su -s /bin/sh webapp -c \
            "/usr/libexec/strataos/web-flatpak-launch $app_id $port" \
            >>/var/log/strata-webui.log 2>&1 &
        launcher_pid=$!
        echo "$launcher_pid" > "$sessions/$app_id/pid"
        if ! awk '{print $22}' "/proc/$launcher_pid/stat" > "$sessions/$app_id/start-time"; then
            release_session "$app_id"
            stop_services_if_idle
            echo "Flatpak session launcher exited during startup; check /var/log/strata-webui.log" >&2
            exit 5
        fi
        count=0
        while [ ! -f "$sessions/$app_id/runtime/vnc-ready" ]; do
            if ! kill -0 "$launcher_pid" 2>/dev/null; then
                release_session "$app_id"
                stop_services_if_idle
                echo "Flatpak session launcher exited during startup; check /var/log/strata-webui.log" >&2
                exit 5
            fi
            count=$((count + 1))
            if [ "$count" -ge 150 ]; then
                release_session "$app_id"
                stop_services_if_idle
                echo "timed out waiting for the graphical session; check /var/log/strata-webui.log" >&2
                exit 6
            fi
            sleep 0.1
        done
        render_mode=$(cat "$sessions/$app_id/runtime/render-mode" 2>/dev/null || true)
        case "$render_mode" in
            gpu|software) ;;
            *)
                release_session "$app_id"
                stop_services_if_idle
                echo "graphical session did not report its renderer" >&2
                exit 5
                ;;
        esac
        printf '%s\n' "$render_mode" > "$sessions/$app_id/render-mode"
        start_time=$(cat "$sessions/$app_id/start-time")
        sh -c '
            while [ -r "/proc/$2/stat" ] &&
                [ "$(awk '\''{print $22}'\'' "/proc/$2/stat" 2>/dev/null)" = "$3" ]; do
                sleep 1
            done
            exec /usr/libexec/strataos/web-flatpak-session reap "$1" "$2" "$3"
        ' sh "$app_id" "$launcher_pid" "$start_time" >/dev/null 2>&1 &
        printf '%s\t%s\t%s\n' "$app_id" "$port" "$render_mode"
        ;;
    stop)
        app_id=${2:-}
        valid_app "$app_id" || { echo "invalid application id" >&2; exit 2; }
        release_session "$app_id"
        stop_services_if_idle
        ;;
    stop-all)
        for directory in "$sessions"/*; do
            [ -d "$directory" ] || continue
            app_id=${directory##*/}
            valid_app "$app_id" || continue
            release_session "$app_id"
        done
        "$services" stop
        ;;
    reap)
        app_id=${2:-}
        expected_pid=${3:-}
        expected_start=${4:-}
        valid_app "$app_id" || exit 0
        current_pid=$(cat "$sessions/$app_id/pid" 2>/dev/null || true)
        current_start=$(cat "$sessions/$app_id/start-time" 2>/dev/null || true)
        if [ "$current_pid" = "$expected_pid" ] && [ "$current_start" = "$expected_start" ]; then
            release_session "$app_id"
        fi
        stop_services_if_idle
        ;;
    status)
        app_id=${2:-}
        if [ -n "$app_id" ]; then
            valid_app "$app_id" || { echo "invalid application id" >&2; exit 2; }
            if session_running "$app_id"; then
                printf '%s\trunning\t%s\t%s\n' "$app_id" \
                    "$(cat "$sessions/$app_id/vnc-port")" "$(session_render_mode "$app_id")"
            else
                [ ! -e "$sessions/$app_id" ] || release_session "$app_id"
                stop_services_if_idle
                printf '%s\tstopped\t0\tunknown\n' "$app_id"
            fi
            exit 0
        fi
        for directory in "$sessions"/*; do
            [ -d "$directory" ] || continue
            item=${directory##*/}
            valid_app "$item" || continue
            if session_running "$item"; then
                printf '%s\trunning\t%s\t%s\n' "$item" \
                    "$(cat "$directory/vnc-port")" "$(session_render_mode "$item")"
            else
                release_session "$item"
            fi
        done
        stop_services_if_idle
        ;;
    *) echo "usage: web-flatpak-session {start APP_ID|stop APP_ID|stop-all|status [APP_ID]}" >&2; exit 2 ;;
esac
