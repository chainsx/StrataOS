#!/bin/sh
# Owned by the webui-flatpak capability component.
set -eu

runtime=/run/strata-webui
tls_config=/etc/strataos/webui/tls.conf
tls_certificate=/etc/strataos/webui/tls.crt
tls_private_key=/etc/strataos/webui/tls.key

pid_running() {
    pidfile=$1
    [ -s "$pidfile" ] || return 1
    pid=$(cat "$pidfile" 2>/dev/null) || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

stop_one() {
    pidfile=$1
    if pid_running "$pidfile"; then
        start-stop-daemon --stop --pidfile "$pidfile" --retry TERM/3/KILL/2 || true
    fi
    rm -f "$pidfile"
}

start_services() {
    mkdir -p "$runtime/sessions" "$runtime/auth-sessions"
    vnc_port=6080
    vnc_bind_args=
    tls=no
    if grep -qx 'enabled=yes' "$tls_config" 2>/dev/null &&
        [ -s "$tls_certificate" ] && [ -s "$tls_private_key" ]; then
        tls=yes
        vnc_port=6081
        vnc_bind_args="-i 127.0.0.1"
    fi

    if ! pid_running "$runtime/wsproxy.pid"; then
        rm -f "$runtime/wsproxy.pid"
        start-stop-daemon --start --background --make-pidfile \
            --pidfile "$runtime/wsproxy.pid" \
            --exec /usr/sbin/strata-wsproxy -- \
            -l "$vnc_port" $vnc_bind_args -d "$runtime/sessions" \
            -t "$runtime/auth-sessions"
    fi
    sleep 0.1
    if ! pid_running "$runtime/wsproxy.pid"; then
        stop_one "$runtime/wsproxy.pid"
        echo "Flatpak WebSocket proxy failed to start" >&2
        return 1
    fi

    if [ "$tls" = yes ] && ! pid_running "$runtime/tls-vnc.pid"; then
        rm -f "$runtime/tls-vnc.pid"
        start-stop-daemon --start --background --make-pidfile \
            --pidfile "$runtime/tls-vnc.pid" \
            --exec /usr/sbin/strata-tlsproxy -- \
            -l 6080 -b 6081 -c "$tls_certificate" -k "$tls_private_key"
        sleep 0.1
        if ! pid_running "$runtime/tls-vnc.pid"; then
            stop_one "$runtime/wsproxy.pid"
            stop_one "$runtime/tls-vnc.pid"
            echo "Flatpak TLS proxy failed to start" >&2
            return 1
        fi
    elif [ "$tls" != yes ]; then
        stop_one "$runtime/tls-vnc.pid"
    fi
}

stop_services() {
    stop_one "$runtime/tls-vnc.pid"
    stop_one "$runtime/wsproxy.pid"
}

case "${1:-}" in
    start) start_services ;;
    stop) stop_services ;;
    status)
        pid_running "$runtime/wsproxy.pid" || exit 1
        if grep -qx 'enabled=yes' "$tls_config" 2>/dev/null &&
            [ -s "$tls_certificate" ] && [ -s "$tls_private_key" ]; then
            pid_running "$runtime/tls-vnc.pid" || exit 1
        fi
        ;;
    *) echo "usage: web-flatpak-services {start|stop|status}" >&2; exit 2 ;;
esac
