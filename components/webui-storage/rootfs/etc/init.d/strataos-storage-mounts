#!/sbin/openrc-run

name="StrataOS external storage mounts"
description="Mount WebUI-managed external filesystems"
conf=/etc/strataos/storage-mounts.conf

depend() {
    need localmount
    after strataos-storage
    before strata-webui
}

start() {
    [ -r "$conf" ] || return 0
    while IFS="$(printf '\t')" read -r device mountpoint; do
        case "$device:$mountpoint" in /dev/[A-Za-z0-9._-]*:/mnt/[A-Za-z0-9._-]*) ;; *) continue ;; esac
        [ -b "$device" ] || continue
        mkdir -p "$mountpoint" || continue
        mountpoint -q "$mountpoint" 2>/dev/null || mount "$device" "$mountpoint" || ewarn "could not mount $device"
    done < "$conf"
}

stop() {
    [ -r "$conf" ] || return 0
    while IFS="$(printf '\t')" read -r device mountpoint; do
        case "$mountpoint" in /mnt/[A-Za-z0-9._-]*) umount "$mountpoint" 2>/dev/null || true ;; esac
    done < "$conf"
}
