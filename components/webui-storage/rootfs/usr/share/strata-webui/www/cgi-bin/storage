#!/bin/sh
# Owned by the webui-storage capability component.
. /usr/libexec/strataos/webui-cgi-common
require_auth
json_headers

MOUNTS=/etc/strataos/storage-mounts.conf

valid_device() {
    case "$1" in /dev/[A-Za-z0-9._-]*) ;; *) return 1 ;; esac
    lsblk -pnro PATH,TYPE 2>/dev/null | awk -v device="$1" '$1 == device && $2 == "part" { found=1 } END { exit !found }'
}

mounted_at() {
    findmnt -nr -S "$1" -o TARGET 2>/dev/null | head -1
}

json_error() { printf '{"error":"%s"}\n' "$(printf '%s' "$1" | json_escape)"; exit 0; }

if [ "${REQUEST_METHOD:-GET}" = GET ]; then
    lsblk -J -b -o NAME,PATH,TYPE,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINTS,RO,MODEL 2>/dev/null || printf '{"blockdevices":[]}\n'
    exit 0
fi

[ "${REQUEST_METHOD:-GET}" = POST ] || json_error "method not allowed"
length=${CONTENT_LENGTH:-0}
case "$length" in ''|*[!0-9]*) json_error "invalid content length" ;; esac
[ "$length" -le 2048 ] || json_error "request body too large"
body=$(dd bs=1 count="$length" 2>/dev/null)
action=$(printf '%s' "$body" | sed -n 's/.*"action"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')
device=$(printf '%s' "$body" | sed -n 's/.*"device"[[:space:]]*:[[:space:]]*"\([^"[:space:]]*\)".*/\1/p')
valid_device "$device" || json_error "device must be a detected partition"

case "$action" in
    mount)
        mount_name=$(printf '%s' "$body" | sed -n 's/.*"mount_name"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9._-]*\)".*/\1/p')
        case "$mount_name" in ''|.|..|*[!A-Za-z0-9._-]*) json_error "invalid mount name" ;; esac
        mountpoint=/mnt/$mount_name
        [ -z "$(mounted_at "$device")" ] || json_error "device is already mounted"
        mkdir -p /mnt "$mountpoint" || json_error "failed to create mount point"
        mount "$device" "$mountpoint" 2>/dev/null || { rmdir "$mountpoint" 2>/dev/null || true; json_error "mount failed; create a supported filesystem first"; }
        mkdir -p /etc/strataos
        temporary=$MOUNTS.new.$$
        awk -F '\t' -v device="$device" '$1 != device { print }' "$MOUNTS" 2>/dev/null > "$temporary"
        printf '%s\t%s\n' "$device" "$mountpoint" >> "$temporary"
        mv "$temporary" "$MOUNTS"
        printf '{"success":true,"device":"%s","mountpoint":"%s"}\n' "$device" "$mountpoint"
        ;;
    unmount)
        mountpoint=$(mounted_at "$device")
        [ -n "$mountpoint" ] || json_error "device is not mounted"
        case "$mountpoint" in /|/state|/boot|/var/lib/flatpak|/var/lib/docker) json_error "managed system storage cannot be unmounted" ;; esac
        umount "$device" 2>/dev/null || json_error "unmount failed; the filesystem may be busy"
        temporary=$MOUNTS.new.$$
        awk -F '\t' -v device="$device" '$1 != device { print }' "$MOUNTS" 2>/dev/null > "$temporary"
        mkdir -p /etc/strataos && mv "$temporary" "$MOUNTS"
        rmdir "$mountpoint" 2>/dev/null || true
        printf '{"success":true,"device":"%s"}\n' "$device"
        ;;
    format)
        filesystem=$(printf '%s' "$body" | sed -n 's/.*"filesystem"[[:space:]]*:[[:space:]]*"\([a-z0-9]*\)".*/\1/p')
        label=$(printf '%s' "$body" | sed -n 's/.*"label"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9._-]*\)".*/\1/p')
        [ -z "$(mounted_at "$device")" ] || json_error "unmount the device before formatting"
        case "$label" in *[!A-Za-z0-9._-]*) json_error "invalid volume label" ;; esac
        case "$filesystem" in
            ext4)
                if [ -n "$label" ]; then mkfs.ext4 -F -L "$label" "$device"; else mkfs.ext4 -F "$device"; fi >/dev/null 2>&1
                ;;
            vfat)
                if [ -n "$label" ]; then mkfs.fat -F 32 -n "$label" "$device"; else mkfs.fat -F 32 "$device"; fi >/dev/null 2>&1
                ;;
            *) json_error "unsupported filesystem" ;;
        esac
        printf '{"success":true,"device":"%s","filesystem":"%s"}\n' "$device" "$filesystem"
        ;;
    *) json_error "invalid action" ;;
esac
