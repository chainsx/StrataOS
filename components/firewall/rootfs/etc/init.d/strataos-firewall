#!/sbin/openrc-run

description="StrataOS nftables firewall"

depend() {
    need localmount
    after strataos-network strataos-logging
    before docker
    provide firewall
}

RULESET=/etc/strataos/firewall/ruleset.nft
FALLBACK=/usr/share/strataos/firewall/fallback.nft
NETWORK_NAT_RULESET=/etc/strataos/network-nat.nft

apply_ruleset() {
    ruleset="$1"
    nft -c -f "$ruleset" 2>/dev/null || return 1
    nft -f "$ruleset" || return 1
    [ ! -s "$NETWORK_NAT_RULESET" ] || { nft -c -f "$NETWORK_NAT_RULESET" 2>/dev/null && nft -f "$NETWORK_NAT_RULESET"; }
}

reload_fail2ban() {
    command -v fail2ban-client >/dev/null 2>&1 || return 0
    rc-service fail2ban status >/dev/null 2>&1 || return 0
    fail2ban-client -s /run/fail2ban/fail2ban.sock reload >/dev/null 2>&1 || true
}

start() {
    ebegin "Applying firewall ruleset"
    if [ -s "$RULESET" ] && apply_ruleset "$RULESET"; then
        reload_fail2ban
        eend 0
        return 0
    fi
    ewarn "persisted ruleset is missing or invalid; applying safe fallback"
    apply_ruleset "$FALLBACK"
    reload_fail2ban
    eend $?
}

stop() {
    ebegin "Restoring safe fallback firewall ruleset"
    apply_ruleset "$FALLBACK"
    eend $?
}
