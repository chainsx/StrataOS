#!/bin/sh
# Owned by the webui-firewall capability component.
. /usr/libexec/strataos/webui-cgi-common
. /usr/libexec/strataos/firewall-common
require_auth
json_headers

mkdir -p "$FW_DIR" || { printf '{"error":"cannot create firewall directory"}\n'; exit 0; }
RULES_LIST=$FW_DIR/rules.list
touch "$RULES_LIST"

fail() {
    printf '{"error":"%s"}\n' "$(printf '%s' "$1" | json_escape)"
    exit 0
}

read_body() {
    length=${CONTENT_LENGTH:-0}
    case "$length" in ''|*[!0-9]*) fail "invalid content length" ;; esac
    [ "$length" -le 32768 ] || fail "request body too large"
    dd bs=1 count="$length" 2>/dev/null
}

field() {
    printf '%s' "$body" | sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p'
}

management_only_ruleset() {
    cat <<'EOF'
flush ruleset
table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        iif lo accept

        tcp dport { 22, 9090, 6080, 7681 } accept
        tcp dport 7690-7789 accept
EOF
    while IFS=' ' read -r rule_action rule_proto rule_port; do
        [ -n "$rule_action" ] || continue
        [ "$rule_action" = allow ] && printf '        %s dport %s accept\n' "$rule_proto" "$rule_port"
    done < "$RULES_LIST"
    cat <<'EOF'
    }
}
EOF
}

allow_all_ruleset() {
    cat <<'EOF'
flush ruleset
table inet filter {
    chain input {
        type filter hook input priority 0; policy accept;

        ct state established,related accept
        iif lo accept

        tcp dport { 22, 9090, 6080, 7681 } accept
        tcp dport 7690-7789 accept
EOF
    while IFS=' ' read -r rule_action rule_proto rule_port; do
        [ -n "$rule_action" ] || continue
        [ "$rule_action" = deny ] && printf '        %s dport %s drop\n' "$rule_proto" "$rule_port"
    done < "$RULES_LIST"
    cat <<'EOF'
    }
}
EOF
}

generate_ruleset() {
    preset=$(fw_kv_get "$FW_CONF" active_preset management-only)
    case "$preset" in
        allow-all) allow_all_ruleset ;;
        *) management_only_ruleset ;;
    esac
}

write_conf_key() {
    key="$1" value="$2"
    tmp="$FW_CONF.tmp.$$"
    { grep -v "^$key=" "$FW_CONF" 2>/dev/null; printf '%s=%s\n' "$key" "$value"; } > "$tmp" \
        && mv "$tmp" "$FW_CONF" \
        || { rm -f "$tmp"; fail "cannot update firewall configuration"; }
}

apply_candidate() {
    generate_ruleset > "$FW_CANDIDATE"
    if ! nft -c -f "$FW_CANDIDATE" 2>/dev/null; then
        rm -f "$FW_CANDIDATE"
        fail "ruleset failed validation"
    fi
    [ ! -s "$FW_RULESET" ] || cp "$FW_RULESET" "$FW_PREVIOUS"
    nft -f "$FW_CANDIDATE" || fail "ruleset failed to apply"
    fw_apply_network_nat || fail "network NAT rules failed to apply"
    fw_reload_fail2ban
    fw_start_rollback_timer "$(fw_confirm_timeout)"
}

status() {
    preset=$(fw_kv_get "$FW_CONF" active_preset management-only)
    pending=false
    remaining=0
    fw_rollback_pending && pending=true
    if [ "$pending" = true ] && [ -s "$FW_ROLLBACK_DEADLINE" ]; then
        deadline=$(cat "$FW_ROLLBACK_DEADLINE")
        remaining=$(( deadline - $(date +%s) ))
        [ "$remaining" -lt 0 ] && remaining=0
    fi
    active=false
    table_count=$(nft -j list ruleset 2>/dev/null | grep -o '"table"' | wc -l)
    [ "${table_count:-0}" -gt 0 ] && active=true
    presets='[{"id":"management-only","name":"Management only","description":"Default deny inbound; only management ports (SSH, WebUI, terminal, VNC) and established connections are allowed."},{"id":"allow-all","name":"Allow all inbound","description":"Default accept inbound; use the rule list below to deny specific ports."}]'
    rules="["
    first=yes
    while IFS=' ' read -r rule_action rule_proto rule_port; do
        [ -n "$rule_action" ] || continue
        [ "$first" = yes ] || rules="$rules,"
        first=no
        rules="$rules{\"action\":\"$rule_action\",\"proto\":\"$rule_proto\",\"port\":\"$rule_port\"}"
    done < "$RULES_LIST"
    rules="$rules]"
    f2b_conf=/etc/fail2ban/jail.d/strataos.conf
    f2b_available=false; f2b_enabled=false; f2b_running=false
    [ -x /etc/init.d/fail2ban ] && command -v fail2ban-server >/dev/null 2>&1 && f2b_available=true
    grep -Eq '^[[:space:]]*enabled[[:space:]]*=[[:space:]]*(true|yes|1)' "$f2b_conf" 2>/dev/null && f2b_enabled=true
    rc-service fail2ban status >/dev/null 2>&1 && f2b_running=true
    f2b_maxretry=$(awk -F= '/^[[:space:]]*maxretry[[:space:]]*=/{gsub(/[[:space:]]/,"",$2);print $2;exit}' "$f2b_conf"); f2b_maxretry=${f2b_maxretry:-5}
    f2b_findtime=$(awk -F= '/^[[:space:]]*findtime[[:space:]]*=/{gsub(/[[:space:]]/,"",$2);print $2;exit}' "$f2b_conf"); f2b_findtime=${f2b_findtime:-600}
    f2b_bantime=$(awk -F= '/^[[:space:]]*bantime[[:space:]]*=/{gsub(/[[:space:]]/,"",$2);print $2;exit}' "$f2b_conf"); f2b_bantime=${f2b_bantime:-600}
    printf '{"preset":"%s","pending":%s,"remaining":%s,"active":%s,"confirm_timeout":%s,"presets":%s,"rules":%s,"fail2ban":{"available":%s,"enabled":%s,"running":%s,"maxretry":%s,"findtime":%s,"bantime":%s}}\n' \
        "$(printf '%s' "$preset" | json_escape)" "$pending" "$remaining" "$active" "$(fw_confirm_timeout)" "$presets" "$rules" "$f2b_available" "$f2b_enabled" "$f2b_running" "$f2b_maxretry" "$f2b_findtime" "$f2b_bantime"
}

case "${REQUEST_METHOD:-GET}" in
    GET)
        status
        ;;
    POST)
        body=$(read_body)
        action=$(field action)
        case "$action" in
            status)
                status
                ;;
            apply_preset)
                preset=$(field preset)
                case "$preset" in management-only|allow-all) : ;; *) fail "invalid preset" ;; esac
                write_conf_key active_preset "$preset"
                apply_candidate
                printf '{"ok":true,"pending":true,"confirm_timeout":%s}\n' "$(fw_confirm_timeout)"
                ;;
            add_rule)
                rule_action=$(field action_type)
                proto=$(field proto)
                port=$(field port)
                case "$rule_action" in allow|deny) : ;; *) fail "invalid rule action" ;; esac
                case "$proto" in tcp|udp) : ;; *) fail "invalid protocol" ;; esac
                ports=$(printf '%s' "$port" | tr -d '[:space:]')
                case "$ports" in ''|,*|*,|*,,*|*[!0-9,-]*) fail "invalid port list" ;; esac
                oldifs=$IFS; IFS=,
                for item in $ports; do
                    case "$item" in ''|*[!0-9-]*|[-]*|*[-]|*--*) IFS=$oldifs; fail "invalid port" ;; esac
                    lo=${item%%-*}; hi=${item##*-}
                    [ "$lo" -ge 1 ] 2>/dev/null && [ "$hi" -le 65535 ] 2>/dev/null && [ "$lo" -le "$hi" ] 2>/dev/null || { IFS=$oldifs; fail "port must be between 1 and 65535"; }
                    if [ "$rule_action" = deny ] && fw_deny_blocks_protected "$item"; then IFS=$oldifs; fail "management ports cannot be blocked"; fi
                done
                for item in $ports; do printf '%s %s %s\n' "$rule_action" "$proto" "$item"; done >> "$RULES_LIST"
                IFS=$oldifs
                apply_candidate
                printf '{"ok":true,"pending":true,"confirm_timeout":%s}\n' "$(fw_confirm_timeout)"
                ;;
            remove_rule)
                proto=$(field proto)
                port=$(field port)
                rule_action=$(field action_type)
                case "$proto" in tcp|udp) : ;; *) fail "invalid protocol" ;; esac
                case "$port" in ''|*[!0-9-]*|[-]*|*[-]|*--*) fail "invalid port" ;; esac
                case "$rule_action" in allow|deny) : ;; *) fail "invalid rule action" ;; esac
                tmp="$RULES_LIST.tmp.$$"
                grep -v -- "^$rule_action $proto $port\$" "$RULES_LIST" > "$tmp" 2>/dev/null || true
                if cmp -s "$tmp" "$RULES_LIST"; then
                    rm -f "$tmp"
                    fail "rule not found"
                fi
                mv "$tmp" "$RULES_LIST"
                apply_candidate
                printf '{"ok":true,"pending":true,"confirm_timeout":%s}\n' "$(fw_confirm_timeout)"
                ;;
            confirm)
                fw_cancel_rollback_timer
                [ -s "$FW_CANDIDATE" ] || fail "no pending change to confirm"
                mv "$FW_CANDIDATE" "$FW_RULESET"
                printf '{"ok":true,"pending":false}\n'
                ;;
            rollback)
                fw_cancel_rollback_timer
                rm -f "$FW_CANDIDATE"
                if [ -s "$FW_PREVIOUS" ]; then
                    nft -f "$FW_PREVIOUS" || fail "unable to restore previous ruleset"
                else
                    nft -f "$FALLBACK" || fail "unable to restore fallback ruleset"
                fi
                fw_apply_network_nat || fail "network NAT rules failed to apply"
                fw_reload_fail2ban
                printf '{"ok":true,"pending":false}\n'
                ;;
            fail2ban_config)
                [ -x /etc/init.d/fail2ban ] && command -v fail2ban-server >/dev/null 2>&1 || fail "Fail2ban component is not installed"
                enabled=$(field enabled); maxretry=$(field maxretry); findtime=$(field findtime); bantime=$(field bantime)
                case "$enabled" in true|false) : ;; *) fail "invalid Fail2ban state" ;; esac
                case "$maxretry" in ''|*[!0-9]*) fail "invalid maximum failures" ;; esac
                [ "$maxretry" -ge 1 ] && [ "$maxretry" -le 20 ] || fail "maximum failures must be 1-20"
                case "$findtime" in 300|600|1800|3600) : ;; *) fail "invalid detection window" ;; esac
                case "$bantime" in 600|3600|21600|86400) : ;; *) fail "invalid ban duration" ;; esac
                mkdir -p /etc/fail2ban/jail.d
                cat > /etc/fail2ban/jail.d/strataos.conf.tmp <<EOF
[DEFAULT]
backend = polling
banaction = nftables-multiport
bantime = $bantime
findtime = $findtime
maxretry = $maxretry

[sshd]
enabled = $enabled
port = ssh
logpath = /var/log/messages
EOF
                mv /etc/fail2ban/jail.d/strataos.conf.tmp /etc/fail2ban/jail.d/strataos.conf
                if [ "$enabled" = true ]; then
                    rc-update add fail2ban default >/dev/null 2>&1 || true
                    rc-service fail2ban restart >/dev/null 2>&1 || rc-service fail2ban start >/dev/null 2>&1 || fail "Fail2ban rejected the configuration"
                else
                    rc-service fail2ban stop >/dev/null 2>&1 || true
                    rc-update del fail2ban default >/dev/null 2>&1 || true
                fi
                printf '{"ok":true}\n'
                ;;
            *) fail "invalid action" ;;
        esac
        ;;
    *) fail "method not allowed" ;;
esac
